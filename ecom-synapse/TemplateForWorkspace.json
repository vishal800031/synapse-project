		{
			"name": "[concat(parameters('workspaceName'), '/SQL script 1')]",
			"type": "Microsoft.Synapse/workspaces/sqlscripts",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"content": {
					"query": "CREATE TABLE dbo.stg_customer_cleaned\n(\n    customer_id VARCHAR(50),\n    first_name VARCHAR(100),\n    last_name VARCHAR(100),\n    email VARCHAR(255),\n    phone VARCHAR(30),\n    age INT,\n    gender VARCHAR(20),\n    city VARCHAR(100),\n    state VARCHAR(100),\n    country VARCHAR(100),\n    signup_date DATE,\n    customer_segment VARCHAR(50),\n    annual_income DECIMAL(18,2),\n    total_spend DECIMAL(18,2),\n    total_orders INT,\n    is_active BIT\n);\n\n\n\n\nSELECT COUNT(*) as total_rows\nFROM dbo.stg_customer_cleaned;\n\n\n\nSELECT\n    customer_id,\n    first_name,\n    last_name,\n    email,\n    age,\n    annual_income,\n    total_spend,\n    total_orders,\n    is_active\nFROM dbo.stg_customer_cleaned\nWHERE age IS NULL\n   OR annual_income IS NULL\n   OR total_spend IS NULL\n   OR total_orders IS NULL\n   OR is_active IS NULL;",
					"metadata": {
						"language": "sql"
					},
					"currentConnection": {
						"databaseName": "sqlpool",
						"poolName": "sqlpool"
					},
					"resultLimit": 5000
				},
				"type": "SqlQuery"
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('workspaceName'), '/transformation_notebook')]",
