{
	"name": "Pipeline 2",
	"properties": {
		"activities": [
			{
				"name": "json2csv",
				"type": "Copy",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "JsonSource",
						"storeSettings": {
							"type": "AzureBlobFSReadSettings",
							"recursive": true,
							"enablePartitionDiscovery": false
						},
						"formatSettings": {
							"type": "JsonReadSettings"
						}
					},
					"sink": {
						"type": "DelimitedTextSink",
						"storeSettings": {
							"type": "AzureBlobFSWriteSettings",
							"copyBehavior": "FlattenHierarchy"
						},
						"formatSettings": {
							"type": "DelimitedTextWriteSettings",
							"quoteAllText": true,
							"fileExtension": ".csv"
						}
					},
					"enableStaging": false,
					"translator": {
						"type": "TabularTranslator",
						"mappings": [
							{
								"source": {
									"path": "$['customer_id']"
								},
								"sink": {
									"name": "customer_id",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['first_name']"
								},
								"sink": {
									"name": "first_name",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['last_name']"
								},
								"sink": {
									"name": "last_name",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['email']"
								},
								"sink": {
									"name": "email",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['phone']"
								},
								"sink": {
									"name": "phone",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['age']"
								},
								"sink": {
									"name": "age",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['gender']"
								},
								"sink": {
									"name": "gender",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['city']"
								},
								"sink": {
									"name": "city",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['state']"
								},
								"sink": {
									"name": "state",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['country']"
								},
								"sink": {
									"name": "country",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['signup_date']"
								},
								"sink": {
									"name": "signup_date",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['customer_segment']"
								},
								"sink": {
									"name": "customer_segment",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['annual_income']"
								},
								"sink": {
									"name": "annual_income",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['total_spend']"
								},
								"sink": {
									"name": "total_spend",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['total_orders']"
								},
								"sink": {
									"name": "total_orders",
									"type": "String"
								}
							},
							{
								"source": {
									"path": "$['is_active']"
								},
								"sink": {
									"name": "is_active",
									"type": "String"
								}
							}
						]
					}
				},
				"inputs": [
					{
						"referenceName": "ds_adls_json_raw",
						"type": "DatasetReference"
					}
				],
				"outputs": [
					{
						"referenceName": "DelimitedText1",
						"type": "DatasetReference",
						"parameters": {
							"folderPath": "staging",
							"fileName": "customers_final.csv"
						}
					}
				]
			},
			{
				"name": "Notebook1",
				"type": "SynapseNotebook",
				"dependsOn": [
					{
						"activity": "json2csv",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"notebook": {
						"referenceName": "transformation_notebook",
						"type": "NotebookReference"
					},
					"snapshot": true,
					"sparkPool": {
						"referenceName": "sparkpool",
						"type": "BigDataPoolReference"
					}
				}
			}
		],
		"annotations": []
	}
}